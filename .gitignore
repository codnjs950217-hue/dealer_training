node_modules/

# Firebase service account keys — full admin access to Firestore, must
# never be committed. Keep them outside the repo or name them so this
# pattern catches them.
*serviceAccountKey*.json
*service-account*.json
*firebase-adminsdk*.json

# 학습리포트 추출 결과(개인 학습 기록) — 커밋 금지
training-report_*

