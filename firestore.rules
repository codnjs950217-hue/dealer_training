rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 사번 로그인: 클라이언트(firebase-init.js의 lookupEmployee)는 Firebase
    // Auth 없이 users/{employeeId} 단일 문서를 getDoc으로 직접 조회한다.
    // 따라서 그 한 건의 get만 허용하고, 그 외는 전부 막는다:
    //   - get   : 허용. 사번을 아는 사람만 그 사번 문서 1건을 읽는다.
    //   - list  : 차단. 컬렉션 쿼리를 막아 users 전체 목록(전 직원 사번·
    //             이름)을 통째로 덤프하는 것을 불가능하게 한다. 앱 어디에도
    //             users 컬렉션 쿼리는 없으므로(단일 doc get만 사용) 기능에
    //             영향 없음.
    //   - write : 차단. 사용자 등록/수정은 firebase-admin을 쓰는
    //             scripts/upload-users.js(관리자 CLI) 전용이며, Admin SDK는
    //             보안 규칙을 우회하므로 이 차단과 무관하게 동작한다.
    // 진짜 Auth가 없어 "본인 문서만 읽기"로 더 좁힐 수는 없다 — 그래서
    // users 문서에는 name/active 외 민감정보를 절대 넣지 말 것.
    match /users/{employeeId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // 룰렛 페이 프랙티스 "🏆 랭킹 도전"의 개인 최고점 리더보드.
    // 이 앱엔 실제 Firebase Auth가 없어(사번 로그인은 클라이언트가 users/
    // {employeeId}를 직접 조회하는 방식) request.auth로 글쓴이가 본인
    // employeeId인지 검증할 수 없다 — users 컬렉션과 동일한 한계. 대신
    // 문서 스키마만 검증해 완전히 임의의 필드/컬렉션 쓰기는 막는다.
    match /rouletteRankings/{employeeId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['name','score','mistakes','updatedAt'])
                   && request.resource.data.name is string
                   && request.resource.data.score is int
                   && request.resource.data.mistakes is int
                   && request.resource.data.updatedAt is int;
    }

    // 룰렛 "⚔️ 배틀하기" (실시간 2-5인 대결) 대기실/경기 상태 문서.
    // 기록이 남지 않는 일회성 방이 목표 — 재대결(rematch) 기능은 없고,
    // 호스트 이탈/전원 퇴장 시 클라이언트가 즉시 문서를 삭제한다
    // (leaveBattleRoom, firebase-init.js). rouletteRankings와 동일한
    // 한계로 request.auth 기반 "본인 항목만 쓰기/삭제" 검증은 불가능하다
    // — 스키마/크기/상태 전이 방향만 검증해 임의 필드 쓰기, 5인 초과,
    // 생성 후 hostId/createdAt 위조, 정해진 경로를 벗어난 상태 전이를
    // 막는다. players 맵은 키가 동적(employeeId)이라 각 항목 내부 필드
    // (name/score/...)까지 룰에서 깊이 검증할 수는 없다 — 바깥쪽 스키마만
    // 검증하는 것도 동일한 한계.
    match /battleRooms/{roomCode} {
      allow read: if true;

      // mode/limitValue(2026-10-02, 호스트 방 설정 화면): 'time'이면
      // limitValue는 제한시간(초, 60 이상), 'round'면 라운드 수(1 이상).
      // 방 생성 시 한 번 정해지면 update 규칙이 불변으로 강제한다 —
      // 참가자는 절대 이 값을 바꿀 수 없다(클라이언트에도 그 UI 자체가
      // 없지만, 규칙으로도 막아둔다).
      allow create: if request.resource.data.keys().hasOnly(
                         ['hostId', 'players', 'status', 'createdAt', 'startedAt', 'mode', 'limitValue'])
                    && request.resource.data.hostId is string
                    && request.resource.data.status == 'waiting'
                    && request.resource.data.createdAt is int
                    && request.resource.data.players is map
                    && request.resource.data.players.size() == 1
                    && request.resource.data.players.keys().hasOnly([request.resource.data.hostId])
                    && request.resource.data.mode in ['time', 'round']
                    && request.resource.data.limitValue is int
                    && (
                      (request.resource.data.mode == 'time'  && request.resource.data.limitValue >= 60) ||
                      (request.resource.data.mode == 'round' && request.resource.data.limitValue >= 1)
                    );

      allow update: if request.resource.data.keys().hasOnly(
                         ['hostId', 'players', 'status', 'createdAt', 'startedAt', 'mode', 'limitValue'])
                    && request.resource.data.hostId == resource.data.hostId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.mode == resource.data.mode
                    && request.resource.data.limitValue == resource.data.limitValue
                    && request.resource.data.status in ['waiting', 'playing', 'finished']
                    // 상태 전이는 이 3가지만 허용: 같은 상태 유지(참가자
                    // 목록/점수 갱신), waiting->playing(시작), playing->
                    // finished(종료). 그 외(playing->waiting, waiting->
                    // finished, finished->playing/waiting 등)는 전부 차단
                    // — 재대결 없이 종료된 방은 삭제만 되고 재사용되지 않는다.
                    && (
                      resource.data.status == request.resource.data.status ||
                      (resource.data.status == 'waiting'  && request.resource.data.status == 'playing') ||
                      (resource.data.status == 'playing'  && request.resource.data.status == 'finished')
                    )
                    && request.resource.data.players is map
                    && request.resource.data.players.size() <= 5;

      // 진행 상태와 무관하게 삭제 허용 — 호스트 이탈(어느 단계에서든 방
      // 즉시 해체), 결과 확인 후 전원 퇴장, 빈 방 정리가 모두 삭제로
      // 구현되어 있어 waiting 단계로 제한할 수 없다. 진짜 인증이 없어
      // "삭제 요청자가 실제 호스트/참가자인지"는 검증 불가 — 다른
      // 컬렉션과 동일한 한계.
      allow delete: if true;
    }

    // 트레이닝 로그(2026-10-02) — 점수/랭킹이 아니라 "얼마나 트레이닝
    // 했는지"만 관리자(개발자)가 Admin SDK 스크립트로 추출해 보는 비공개
    // 집계다. 사용자에게는 절대 보여주지 않으므로 read는 누구에게도
    // 허용하지 않는다 — Admin SDK는 보안 규칙을 우회하므로 추출
    // 스크립트엔 영향이 없다. 문서 ID를 {날짜}_{employeeId}_{game}으로
    // 고정해, 본문 필드로 그 ID를 재구성한 값과 실제 문서 ID가 일치하는지
    // 검증한다 — 다른 사람의 사번으로 로그를 쓰거나 ID와 내용이 어긋나는
    // 문서를 만들 수 없다(진짜 Auth가 없어 "그 사번 본인인지"까지는
    // 검증 불가 — users/rouletteRankings와 동일한 한계).
    //
    // 2026-10-06(학습리포트): mistakes/sessionCount/lastAt/department 추가.
    // 넷 다 "있으면 타입 검증"으로 둔다 — 이 필드들 이전에 생긴 문서와,
    // 배포 직후 아직 예전 main.js를 들고 있는 클라이언트의 쓰기(예전
    // 6개 필드만 보냄)도 계속 통과해야 하기 때문이다.
    match /trainingLogs/{logId} {
      allow read: if false;
      allow write: if request.resource.data.keys().hasOnly(['date','employeeId','name','game','playMinutes','playCount',
                                                            'mistakes','sessionCount','lastAt','department'])
                   && (!('mistakes' in request.resource.data) || request.resource.data.mistakes is int)
                   && (!('sessionCount' in request.resource.data) || request.resource.data.sessionCount is int)
                   && (!('lastAt' in request.resource.data) || request.resource.data.lastAt is int)
                   && (!('department' in request.resource.data) || request.resource.data.department is string)
                   && request.resource.data.date is string
                   && request.resource.data.employeeId is string
                   && request.resource.data.name is string
                   && request.resource.data.game in ['Blackjack', 'Baccarat', 'Roulette', 'Poker']
                   && request.resource.data.playMinutes is int
                   && request.resource.data.playCount is int
                   && logId == request.resource.data.date + '_' + request.resource.data.employeeId + '_' + request.resource.data.game;
    }

    // 그 외 컬렉션은 기본적으로 전부 차단.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
