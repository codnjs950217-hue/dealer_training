rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 사번 로그인: 클라이언트가 Auth 없이 users/{employeeId}를 직접 조회하므로
    // 읽기는 전체 허용, 쓰기는 전체 차단한다. name/active 외 민감정보를
    // users 문서에 넣지 말 것 — 이 컬렉션은 사실상 공개 읽기 대상이다.
    match /users/{employeeId} {
      allow read: if true;
      allow write: if false;
    }

    // 룰렛 페이 프랙티스 "🏆 랭킹 도전"의 개인 최고점 리더보드.
    // 이 앱엔 실제 Firebase Auth가 없어(사번 로그인은 클라이언트가 users/
    // {employeeId}를 직접 조회하는 방식) request.auth로 글쓴이가 본인
    // employeeId인지 검증할 수 없다 — users 컬렉션과 동일한 한계. 대신
    // 문서 스키마만 검증해 완전히 임의의 필드/컬렉션 쓰기는 막는다.
    match /rouletteRankings/{employeeId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['name','score','mistakes','updatedAt'])
                   && request.resource.data.name is string
                   && request.resource.data.score is int
                   && request.resource.data.mistakes is int
                   && request.resource.data.updatedAt is int;
    }

    // 룰렛 "⚔️ 배틀하기" (실시간 2-5인 대결) 대기실/경기 상태 문서.
    // rouletteRankings와 동일한 한계로 request.auth 기반 "본인 항목만
    // 쓰기" 검증은 불가능하다 — 스키마/크기/상태 전이 방향만 검증해
    // 임의 필드 쓰기, 5인 초과, 생성 후 hostId/createdAt 위조, 종료된
    // 방을 되살리는 update를 막는다. players 맵은 키가 동적(employeeId)
    // 이라 각 항목 내부 필드(name/score/...)까지 룰에서 깊이 검증할 수는
    // 없다 — 바깥쪽 스키마만 검증하는 것도 동일한 한계.
    match /battleRooms/{roomCode} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(
                         ['hostId', 'players', 'status', 'createdAt', 'startedAt'])
                    && request.resource.data.hostId is string
                    && request.resource.data.status == 'waiting'
                    && request.resource.data.createdAt is int
                    && request.resource.data.players is map
                    && request.resource.data.players.size() == 1
                    && request.resource.data.players.keys().hasOnly([request.resource.data.hostId]);

      allow update: if request.resource.data.keys().hasOnly(
                         ['hostId', 'players', 'status', 'createdAt', 'startedAt'])
                    && request.resource.data.hostId == resource.data.hostId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.status in ['waiting', 'playing', 'finished']
                    // 상태는 waiting -> playing -> finished 순으로만 전진 가능
                    && !(resource.data.status == 'finished' && request.resource.data.status != 'finished')
                    && !(resource.data.status == 'playing' && request.resource.data.status == 'waiting')
                    && request.resource.data.players is map
                    && request.resource.data.players.size() <= 5;

      // 시작 전(waiting) 방만 삭제 허용 — 진행 중/종료된 방을 다른
      // 탭에서 실수로 지워 다른 플레이어의 경기를 끊는 것을 막는다.
      allow delete: if resource.data.status == 'waiting';
    }

    // 그 외 컬렉션은 기본적으로 전부 차단.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
